<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <!-- Header: LM label -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LM"
            android:textColor="@color/brand_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Arena"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Thinking indicator -->
    <LinearLayout
        android:id="@+id/thinkingLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingVertical="4dp">

        <ProgressBar
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminateTint="@color/brand_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="생각하는 중..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginStart="6dp" />

    </LinearLayout>

    <!-- Thinking/reasoning text (collapsible) -->
    <LinearLayout
        android:id="@+id/reasoningLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="@drawable/bg_reasoning"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginVertical="4dp">

        <TextView
            android:id="@+id/reasoningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:maxLines="5"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Main message content container -->
    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
