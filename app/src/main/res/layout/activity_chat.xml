<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Main content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_secondary"
            android:paddingHorizontal="8dp"
            android:elevation="2dp">

            <ImageButton
                android:id="@+id/menuBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_sidebar"
                android:tint="@color/text_primary" />

            <TextView
                android:id="@+id/topBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Direct 모드"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

            <!-- Status dot -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/shape_status_dot"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connecting"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/newChatBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_new_chat"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/new_chat"
                android:tint="@color/text_primary" />

        </LinearLayout>

        <!-- Chat scroll area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="140dp">

            <LinearLayout
                android:id="@+id/chatInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingHorizontal="12dp">

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="80dp"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LM"
                        android:textColor="@color/brand_primary"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_chat_title"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_chat_sub"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Composer (bottom input area) -->
        <LinearLayout
            android:id="@+id/composerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_primary"
            android:layout_gravity="bottom"
            android:elevation="4dp">

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <EditText
                    android:id="@+id/promptInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/placeholder_input"
                    android:hintTextColor="@color/text_placeholder"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:minHeight="44dp"
                    android:maxLines="6"
                    android:inputType="textMultiLine|textCapSentences"
                    android:imeOptions="actionNone"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/brand_primary"
                    android:contentDescription="@string/send_message" />

            </LinearLayout>

            <!-- Mode selector bar -->
            <LinearLayout
                android:id="@+id/modeBar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingBottom="4dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Direct"
                    android:textSize="12sp"
                    android:checkable="true"
                    android:checked="true"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipMinHeight="32dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAgent"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Agent"
                    android:textSize="12sp"
                    android:checkable="true"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp"
                    android:textColor="@color/chip_text_selector"
                    app:chipMinHeight="32dp"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Sidebar drawer -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_secondary"
        android:layout_gravity="start"
        android:elevation="8dp">

        <!-- Sidebar top -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LM Arena"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeSidebarBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_close"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_sidebar"
                android:tint="@color/text_secondary" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginHorizontal="16dp" />

        <!-- Sidebar content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Status section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <View
                        android:id="@+id/sidebarStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/shape_status_dot" />

                    <TextView
                        android:id="@+id/sidebarStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/connecting"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_light"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp" />

                <!-- Chat mode section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="채팅 모드"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp" />

                <RadioGroup
                    android:id="@+id/chatModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="8dp">

                    <RadioButton
                        android:id="@+id/radioModeDirect"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Direct"
                        android:checked="true"
                        android:button="@null"
                        android:gravity="center"
                        android:textColor="@color/sidebar_radio_text"
                        android:textSize="13sp"
                        android:background="@drawable/bg_mode_radio"
                        android:layout_marginEnd="4dp" />

                    <RadioButton
                        android:id="@+id/radioModeAgent"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="Agent"
                        android:button="@null"
                        android:gravity="center"
                        android:textColor="@color/sidebar_radio_text"
                        android:textSize="13sp"
                        android:background="@drawable/bg_mode_radio"
                        android:layout_marginStart="4dp" />

                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_light"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="8dp" />

                <!-- Info note -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="안드로이드 버전은 파일 저장, Work 에이전트, Workspace 공유 기능을 지원하지 않습니다."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp" />

            </LinearLayout>

        </ScrollView>

        <!-- Bottom actions -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_light"
            android:layout_marginHorizontal="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/logout"
            android:textColor="@color/status_error"
            android:textSize="14sp"
            app:backgroundTint="@color/transparent"
            app:strokeColor="@color/transparent"
            app:rippleColor="@color/status_error"
            android:layout_margin="12dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
